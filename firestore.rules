rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dasilva12cabindes@gmail.com';
    }

    match /produtos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clientes/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    match /pedidos/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin()
        || (request.auth != null && (resource.data.clienteEmail == request.auth.token.email || resource.data.email == request.auth.token.email));
      allow update, delete: if isAdmin();
    }

    match /notificacoes/{id} {
      allow create: if isAdmin();
      allow read: if isAdmin()
        || (request.auth != null && (resource.data.paraUid == request.auth.uid || resource.data.paraEmail == request.auth.token.email));
      allow update: if isAdmin() || (request.auth != null && resource.data.paraUid == request.auth.uid);
      allow delete: if isAdmin();
    }
  }
}