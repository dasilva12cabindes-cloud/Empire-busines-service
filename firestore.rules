rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TROQUE pelo e-mail do admin
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'SEU_EMAIL_ADMIN@gmail.com';
    }

    match /produtos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /clientes/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    match /pedidos/{id} {
      allow create: if request.auth != null;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.clienteEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }
  }
}
